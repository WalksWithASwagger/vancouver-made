{
  "name": "vancouver-made",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VANCOUVER MADE — an anti-establishment protest brand confronting FIFA World Cup 2026, mega-event capitalism, and Vancouver's history of displacement.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:seo": "vite build && python3 scripts/build-social-cards.py && node scripts/prerender.mjs && node scripts/gen-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "preview": "vite preview --host",
    "db:init": "node scripts/init-db.js",
    "server": "node src/server/api.js",
    "ingest": "node scripts/ingest-assets.js --db",
    "dev:all": "concurrently \"node src/server/api.js\" \"vite\"",
    "test:smoke": "node scripts/smoke-test.js",
    "test:seo": "node scripts/seo-check.mjs",
    "test:kit-reading": "node scripts/kit-reading-check.mjs",
    "stage:reel": "node scripts/stage-reel-assets.mjs",
    "record:reel": "node scripts/record-reel.mjs",
    "stage:wall": "node scripts/stage-wall-assets.mjs",
    "record:wall": "node scripts/record-wall.mjs"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "playwright": "^1.61.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
